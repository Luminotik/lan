# Server
PORT=3001

# Database
DB_HOST=
DB_PORT=5432
DB_NAME=lan
DB_USER=lan
DB_PASS=

# Admin console
# Hash:   node -e "import('bcrypt').then(m => m.default.hash('yourpassword', 12).then(console.log))"
ADMIN_PASSWORD_HASH=
# Secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# NODE_ENV=production is set in the Docker image (enables the Secure cookie flag).
# Leave it unset for local development over plain HTTP.
